---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProductCard from "../components/ProductCard.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { withBase } from "../lib/paths";
import { CATEGORIES } from "../lib/categories";

const home = (await getEntry("home", "home"))!.data;
const settings = (await getEntry("settings", "site"))!.data;
const products = await getCollection("products");
const featured = products.filter((p) => p.data.featured).slice(0, 4);
const solutions = (await getCollection("solutions")).sort((a, b) => a.data.order - b.data.order);
const testimonials = await getCollection("testimonials");

const countByCategory = Object.fromEntries(
  CATEGORIES.map((c) => [c.slug, products.filter((p) => p.data.category === c.label).length]),
);

// Platforms strip: typographic chips, not redrawn third-party logos (R-23).
const platforms = ["WordPress", "Shopify", "Odoo", "Dolibarr", "Chrome", "AI APIs"];
---

<!--
  Hero: one focal point (the headline), the gradient reserved for one
  accent word and the primary CTA, stripe motif echoing the logo.
-->
<BaseLayout title={settings.site_title}>
  <section class="relative overflow-hidden">
    <div class="stripe-motif absolute inset-y-0 right-0 hidden w-1/3 text-brand-wash lg:block" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:py-20 lg:grid-cols-[3fr_2fr] lg:py-24">
      <div>
        <p class="font-display text-sm font-bold text-brand">{settings.tagline}</p>
        <h1 class="mt-3 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
          Software that fits the <span class="brand-gradient-text">platforms you already run</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-soft">{home.hero_subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={withBase(home.hero_primary_cta.url)}
            class="brand-gradient inline-flex min-h-11 items-center rounded-lg px-6 py-3 font-semibold text-white hover:opacity-90"
          >
            {home.hero_primary_cta.text}
          </a>
          <a
            href={withBase(home.hero_secondary_cta.url)}
            class="inline-flex min-h-11 items-center rounded-lg border border-brand/30 px-6 py-3 font-semibold text-brand hover:bg-brand-wash"
          >
            {home.hero_secondary_cta.text}
          </a>
        </div>
      </div>
      <div class="hidden justify-center lg:flex">
        <img
          src={withBase("/images/brand/grintbyte-thumb-sm.png")}
          alt=""
          width="280"
          height="280"
          class="h-64 w-64 object-contain"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>
<!--
  Platform strip: typographic chips (real platform names, no fabricated logo bar)
-->

  <section class="border-y border-brand-wash bg-paper-dim" aria-label="Platforms we build for">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-6">
      <p class="text-sm font-semibold text-ink-soft">We build for:</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        <!--
          Category grid
        -->
        {platforms.map((p) => (
          <li class="font-display text-sm font-bold text-ink">{p}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
    <SectionHeading
      title="Products by platform"
      lead="Every product lives inside an ecosystem you already use. Pick yours."
    />
    <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {CATEGORIES.map((c) => (
        <li>
          <a
            href={withBase(`/products/${c.slug}`)}
            class="group flex h-full min-h-11 items-start gap-4 rounded-xl border border-brand-wash p-5 transition-colors hover:border-brand/40 hover:bg-paper-dim"
          >
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-wash text-brand">
              <Icon name={c.icon} class="h-5.5 w-5.5" />
            </span>
            <span>
              <span class="block font-bold group-hover:text-brand">{c.label}</span>
              <span class="mt-1 block text-sm leading-snug text-ink-soft">{c.blurb}</span>
              <span class="mt-2 block text-xs font-semibold text-brand">
                {countByCategory[c.slug]} {countByCategory[c.slug] === 1 ? "product" : "products"}
              </span>
            </span>
          </a>
        </li>
      ))}
      <li>
        <a
          href={withBase("/products")}
          class="flex h-full min-h-28 items-center justify-center rounded-xl border border-dashed border-brand/40 p-5 font-semibold text-brand hover:bg-brand-wash"
        >
          Browse the full catalog
        </a>
      </li>
    </ul>
  </section>

  {home.show_featured && featured.length > 0 && (
    <section class="bg-paper-dim">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
        <SectionHeading
          title="Featured products"
          lead="A few of the products our team maintains and uses most."
        />
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {featured.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!--
    Solutions: numbered rows, a deliberately different composition from
    the two card grids above (RHYTHM 2: one clear break per page).
  -->
  {home.show_solutions && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
      <SectionHeading
        title="Solutions, when a product is not enough"
        lead="Some problems need a team, not a download. These are the services behind our products."
      />
      <ol class="mt-10 divide-y divide-brand-wash border-y border-brand-wash">
        {solutions.map((s, i) => (
          <li>
            <a
              href={withBase(`/solutions/${s.id}`)}
              class="group grid min-h-11 gap-2 py-6 sm:grid-cols-[3rem_16rem_1fr] sm:items-baseline sm:gap-6"
            >
              <span class="font-display text-sm font-bold text-brand" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="font-display text-lg font-bold group-hover:text-brand">{s.data.title}</h3>
              <p class="text-sm leading-relaxed text-ink-soft">{s.data.short_description}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {home.show_stats && home.stats.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-16" aria-label="Numbers">
      <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        {home.stats.map((s) => (
          <div class="rounded-xl border border-brand-wash p-6">
            <dd class="font-display text-3xl font-extrabold text-brand">{s.value}</dd>
            <dt class="mt-1 text-sm text-ink-soft">{s.label}</dt>
          </div>
        ))}
      </dl>
    </section>
  )}

  {home.show_testimonials && testimonials.length > 0 && (
    <section class="bg-paper-dim">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:py-20">
        <SectionHeading title="What clients say" />
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="rounded-xl border border-brand-wash bg-paper p-6">
              <blockquote class="text-sm leading-relaxed">“{t.data.quote}”</blockquote>
              <figcaption class="mt-4 text-sm">
                <span class="font-semibold">{t.data.name}</span>
                <span class="block text-ink-soft">{t.data.company}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>
