---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const about = (await getEntry("about", "about"))!.data;
const settings = (await getEntry("settings", "site"))!.data;
---

<BaseLayout title="About" description={about.intro}>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        About {settings.site_title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">{about.intro}</p>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16">
      <section aria-labelledby="story-title">
        <h2 id="story-title" class="text-2xl font-extrabold tracking-tight">How we got here</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">{about.story}</p>
      </section>
      <section aria-labelledby="mission-title" class="h-fit rounded-xl bg-paper-dim p-6 lg:p-8">
        <h2 id="mission-title" class="text-sm font-bold uppercase tracking-wide text-brand">Mission</h2>
        <p class="mt-3 font-display text-xl font-bold leading-snug">{about.mission}</p>
      </section>
    </div>

    <section class="mt-16" aria-labelledby="values-title">
      <h2 id="values-title" class="text-2xl font-extrabold tracking-tight">How we work</h2>
      <div class="mt-8 grid gap-px overflow-hidden rounded-xl border border-brand-wash bg-brand-wash sm:grid-cols-3">
        {about.values.map((v, i) => (
          <div class="bg-paper p-6">
            <span class="font-display text-sm font-bold text-brand" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="mt-2 font-display text-lg font-bold">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{v.description}</p>
          </div>
        ))}
      </div>
    </section>

    {about.team.length > 0 && (
      <section class="mt-16" aria-labelledby="team-title">
        <h2 id="team-title" class="text-2xl font-extrabold tracking-tight">Team</h2>
        <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {about.team.map((m) => (
            <li class="rounded-xl border border-brand-wash p-5 text-center">
              {m.photo ? (
                <img src={withBase(m.photo)} alt={m.name} class="mx-auto h-20 w-20 rounded-full object-cover" width="80" height="80" loading="lazy" />
              ) : (
                <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-brand-wash font-display text-2xl font-bold text-brand" aria-hidden="true">
                  {m.name.charAt(0)}
                </span>
              )}
              <p class="mt-3 font-semibold">{m.name}</p>
              <p class="text-sm text-ink-soft">{m.role}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </section>

</BaseLayout>
