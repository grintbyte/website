---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import CircuitMotif from "../../components/CircuitMotif.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import RevealScript from "../../components/RevealScript.astro";
import { withBase } from "../../lib/paths";
import { breadcrumbLd } from "../../lib/seo";

export async function getStaticPaths() {
  const solutions = await getCollection("solutions");
  return solutions.map((solution) => ({
    params: { slug: solution.id },
    props: { solution },
  }));
}

const { solution } = Astro.props;
const { data } = solution;
const { Content } = await render(solution);
const crumbs = breadcrumbLd(Astro.site, [
  ["Solutions", "/solutions"],
  [data.title, null],
]);

// Orbital hero visual (mirrors the home hero): the solution's own process
// step titles float as chips, so the animation carries this page's context.
const chipSteps = data.process_steps.slice(0, 4);
const chipPositions = ["left-0 top-[4%]", "right-0 top-[20%]", "left-[2%] bottom-[20%]", "right-[8%] bottom-0"];

const projects = (await getCollection("projects"))
  .filter((p) => p.data.solution === solution.id)
  .sort((a, b) => a.data.order - b.data.order);
const projectTags = [...new Set(projects.flatMap((p) => p.data.tags))];
---

<BaseLayout title={data.title} description={data.short_description} jsonLd={[crumbs]}>
  <!-- Hero: same composition as the home hero (circuit motif + orbital visual) -->
  <section class="relative overflow-hidden">
    <CircuitMotif />
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:py-20 lg:grid-cols-[3fr_2fr]">
      <div>
        <nav aria-label="Breadcrumb" class="reveal revealed text-sm text-ink-soft">
          <a href={withBase("/solutions")} class="hover:text-brand hover:underline">Solutions</a>
          <span aria-hidden="true"> / </span>
          <span aria-current="page">{data.title}</span>
        </nav>
        <h1 class="reveal revealed mt-4 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl" style="--reveal-delay:.1s">
          {data.title}
        </h1>
        <p class="reveal revealed mt-5 max-w-xl text-lg leading-relaxed text-ink-soft" style="--reveal-delay:.2s">
          {data.short_description}
        </p>
        <div class="reveal revealed mt-8 flex flex-wrap gap-3" style="--reveal-delay:.3s">
          <a
            href={withBase(`/contact?solution=${solution.id}`)}
            class="brand-gradient inline-flex min-h-11 items-center rounded-lg px-6 py-3 font-semibold text-white hover:opacity-90"
          >
            {data.cta_text}
          </a>
          {data.process_steps.length > 0 && (
            <a
              href="#how-it-works"
              class="inline-flex min-h-11 items-center rounded-lg border border-brand/30 px-6 py-3 font-semibold text-brand hover:bg-brand-wash"
            >
              See how it works
            </a>
          )}
        </div>
      </div>

      <div class="relative mx-auto hidden h-[380px] w-full max-w-[440px] lg:block" aria-hidden="true">
        <div class="orbit-ring absolute left-1/2 top-1/2 h-[270px] w-[270px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-brand/15"></div>
        <div class="orbit-ring absolute left-1/2 top-1/2 h-[350px] w-[350px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-brand/10 [animation-direction:reverse]"></div>
        <div class="absolute left-1/2 top-1/2 h-40 w-40 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-light/15 blur-2xl"></div>
        <div class="animate-float absolute left-1/2 top-1/2 flex h-36 w-36 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-brand-wash bg-paper shadow-lg shadow-brand-deep/10">
          <Icon name={data.icon ?? "layers"} class="h-14 w-14 text-brand" />
        </div>
        {chipSteps.map((step, i) => (
          <span
            class={`animate-float absolute ${chipPositions[i]} flex items-center gap-2.5 rounded-xl border border-brand-wash bg-paper/90 px-3.5 py-2.5 shadow-md shadow-brand-deep/8 backdrop-blur-sm`}
            style={`--float-delay:${(i * 0.7).toFixed(1)}s`}
          >
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand text-[10px] font-bold text-white">{i + 1}</span>
            <span class="text-xs font-semibold">{step.title}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr]">
      {data.benefits.length > 0 && (
        <section aria-labelledby="benefits-title" class="reveal">
          <h2 id="benefits-title" class="text-xl font-bold">What you get</h2>
          <ul class="mt-4 space-y-3">
            {data.benefits.map((b) => (
              <li class="flex items-start gap-3 rounded-lg bg-paper-dim p-4 text-sm leading-relaxed">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                {b}
              </li>
            ))}
          </ul>
        </section>
      )}

      {data.process_steps.length > 0 && (
        <section id="how-it-works" aria-labelledby="process-title" class="reveal scroll-mt-24">
          <h2 id="process-title" class="text-xl font-bold">How it works</h2>
          <ol class="mt-4 space-y-5 border-l-2 border-brand-wash pl-6">
            {data.process_steps.map((step, i) => (
              <li class="relative">
                <span
                  class="absolute -left-[31px] top-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-brand text-[10px] font-bold text-white"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <h3 class="font-display font-bold">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-soft">{step.description}</p>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>

    <section class="prose-grint mt-12 max-w-none">
      <Content />
    </section>
  </article>

  {projects.length > 0 && (
    <section id="projects" class="border-t border-brand-wash bg-paper-dim" aria-label="Projects">
      <div class="reveal mx-auto max-w-6xl px-4 py-14 sm:py-16">
        <SectionHeading
          title="Projects"
          lead={`Work this solution has shaped. Click a tile for the full picture.`}
        />
        {projectTags.length > 1 && (
          <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filter projects by tag">
            <button type="button" data-filter="" class="filter-btn is-active min-h-9 rounded-full border border-brand/30 px-4 py-1.5 text-sm font-semibold text-brand transition-colors hover:bg-brand-wash" aria-pressed="true">All</button>
            {projectTags.map((t) => (
              <button type="button" data-filter={t} class="filter-btn min-h-9 rounded-full border border-brand/30 px-4 py-1.5 text-sm font-semibold text-brand transition-colors hover:bg-brand-wash" aria-pressed="false">{t}</button>
            ))}
          </div>
        )}
        <ul id="project-grid" class="relative mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {projects.map((p, i) => (
            <li class="project-item" data-tags={p.data.tags.join("|")}>
              <button
                type="button"
                data-open={`project-${i}`}
                class="group block w-full overflow-hidden rounded-xl border border-brand-wash bg-paper text-left shadow-sm transition-shadow hover:shadow-md hover:shadow-brand-deep/10"
              >
                {p.data.thumbnail ? (
                  <img src={withBase(p.data.thumbnail)} alt="" class="aspect-square w-full object-cover" loading="lazy" />
                ) : (
                  <span class="flex aspect-square w-full items-center justify-center bg-gradient-to-br from-brand-wash to-paper-dim">
                    <Icon name={data.icon ?? "layers"} class="h-10 w-10 text-brand/60 transition-transform group-hover:scale-110" />
                  </span>
                )}
                <span class="block border-t border-brand-wash px-3.5 py-3">
                  <span class="block text-sm font-semibold leading-snug group-hover:text-brand">{p.data.title}</span>
                  {p.data.tags.length > 0 && (
                    <span class="mt-1 block text-xs text-ink-soft">{p.data.tags.join(" · ")}</span>
                  )}
                </span>
              </button>

              <dialog
                id={`project-${i}`}
                class="m-auto w-[min(92vw,34rem)] rounded-2xl p-0 shadow-xl backdrop:bg-brand-deep/40 backdrop:backdrop-blur-sm"
              >
                <form method="dialog">
                  <button
                    class="absolute right-3 top-3 flex h-11 w-11 items-center justify-center rounded-full bg-paper/80 text-ink-soft backdrop-blur-sm hover:bg-brand-wash hover:text-brand"
                    aria-label="Close"
                  >
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                  </button>
                </form>
                {p.data.thumbnail ? (
                  <img src={withBase(p.data.thumbnail)} alt="" class="aspect-[2/1] w-full object-cover" loading="lazy" />
                ) : (
                  <div class="flex aspect-[2/1] w-full items-center justify-center bg-gradient-to-br from-brand-wash to-paper-dim" aria-hidden="true">
                    <Icon name={data.icon ?? "layers"} class="h-12 w-12 text-brand/60" />
                  </div>
                )}
                <div class="p-6">
                  {p.data.tags.length > 0 && (
                    <p class="flex flex-wrap gap-1.5">
                      {p.data.tags.map((t) => (
                        <span class="rounded-full bg-brand-wash px-2.5 py-0.5 text-xs font-semibold text-brand-deep">{t}</span>
                      ))}
                    </p>
                  )}
                  <h3 class="mt-3 text-xl font-extrabold tracking-tight">{p.data.title}</h3>
                  {(p.data.platform || p.data.year) && (
                    <p class="mt-1 text-sm text-ink-soft">
                      {[p.data.platform, p.data.year].filter(Boolean).join(" · ")}
                    </p>
                  )}
                  <p class="mt-3 text-sm leading-relaxed text-ink-soft">{p.data.summary}</p>
                  <a
                    href={withBase(`/contact?solution=${solution.id}`)}
                    class="brand-gradient mt-5 inline-flex min-h-11 items-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
                  >
                    Discuss a project like this
                  </a>
                </div>
              </dialog>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBand
    title={data.cta_text}
    body="One short call is usually enough to tell whether this is the right path."
    ctaText={data.cta_text}
    ctaHref={`/contact?solution=${solution.id}`}
  />
  <RevealScript />
</BaseLayout>

<script>
  // Tag filter, isotope-style: leavers fade out in place, entrants fade in,
  // and survivors FLIP-slide to their new grid positions.
  const grid = document.getElementById("project-grid");
  if (grid) {
    const motionOK = matchMedia("(prefers-reduced-motion: no-preference)").matches;
    const items = Array.from(grid.querySelectorAll<HTMLElement>(".project-item"));
    const hideTimers = new WeakMap<HTMLElement, number>();
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filter-btn"));
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => {
          b.classList.toggle("is-active", b === btn);
          b.setAttribute("aria-pressed", String(b === btn));
        });
        const tag = btn.dataset.filter!;
        const gridRect = grid.getBoundingClientRect();
        const first = new Map(
          items.filter((el) => !el.classList.contains("hidden")).map((el) => [el, el.getBoundingClientRect()]),
        );
        items.forEach((el) => {
          clearTimeout(hideTimers.get(el));
          el.style.cssText = "";
          const show = !tag || el.dataset.tags!.split("|").includes(tag);
          if (show) {
            if (el.classList.contains("hidden")) {
              el.classList.remove("hidden");
              el.classList.add("is-away");
              requestAnimationFrame(() => el.classList.remove("is-away"));
            } else {
              el.classList.remove("is-away");
            }
          } else if (!el.classList.contains("hidden")) {
            if (motionOK) {
              // Pin at the old spot (out of flow) so it fades where it stood
              // while the survivors slide into the freed space.
              const r = first.get(el)!;
              el.style.cssText = `position:absolute;left:${r.left - gridRect.left}px;top:${r.top - gridRect.top}px;width:${r.width}px;`;
              el.classList.add("is-away");
              hideTimers.set(
                el,
                window.setTimeout(() => {
                  el.classList.add("hidden");
                  el.style.cssText = "";
                }, 200),
              );
            } else {
              el.classList.add("hidden");
            }
          }
        });
        // FLIP: survivors jump to the new layout, then transform back to the
        // old spot and release, so they appear to slide.
        if (motionOK)
          requestAnimationFrame(() => {
            first.forEach((r, el) => {
              if (el.classList.contains("hidden") || el.classList.contains("is-away")) return;
              const now = el.getBoundingClientRect();
              const dx = r.left - now.left;
              const dy = r.top - now.top;
              if (!dx && !dy) return;
              el.style.transition = "none";
              el.style.transform = `translate(${dx}px,${dy}px)`;
              requestAnimationFrame(() => {
                el.style.transition = "";
                el.style.transform = "";
              });
            });
          });
      });
    });

    // Modals: native <dialog>, closed by the X (method=dialog), Esc, or backdrop click.
    document.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((btn) => {
      btn.addEventListener("click", () => {
        (document.getElementById(btn.dataset.open!) as HTMLDialogElement).showModal();
      });
    });
    document.querySelectorAll<HTMLDialogElement>("dialog").forEach((d) => {
      d.addEventListener("click", (e) => {
        if (e.target === d) d.close();
      });
    });
  }
</script>
