---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
// Rough read time from the raw markdown; honest enough for a byline.
const minutes = Math.max(1, Math.round((post.body ?? "").split(/\s+/).length / 200));
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <article class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
      <a href={withBase("/blog")} class="hover:text-brand hover:underline">Blog</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{post.data.title}</span>
    </nav>
    <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
      {post.data.title}
    </h1>
    <p class="mt-3 text-sm text-ink-soft">{fmt} · {minutes} min read · GrintByte</p>
    {post.data.cover && (
      <img src={withBase(post.data.cover)} alt="" class="mt-6 w-full rounded-xl border border-brand-wash" />
    )}
    <div class="prose-grint mt-8">
      <Content />
    </div>
    {post.data.tags.length > 0 && (
      <p class="mt-8 flex flex-wrap gap-2">
        {post.data.tags.map((t) => (
          <span class="rounded-md bg-brand-wash px-2 py-0.5 text-xs font-semibold text-brand-deep">{t}</span>
        ))}
      </p>
    )}
  </article>
</BaseLayout>
