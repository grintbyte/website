---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogSidebar from "../../components/BlogSidebar.astro";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
// TOC (owner-directed, sweetcode-style right column): h2 anchors with their
// h3 children indented. Astro gives every markdown heading an id.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const fmt = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
// Rough read time from the raw markdown; honest enough for a byline.
const minutes = Math.max(1, Math.round((post.body ?? "").split(/\s+/).length / 200));

const abs = (path: string) => new URL(withBase(path), Astro.site).toString();
const postLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString().slice(0, 10),
  url: abs(`/blog/${post.id}`),
  ...(post.data.cover && { image: abs(post.data.cover) }),
  author: { "@type": "Organization", name: "GrintByte", url: abs("/") },
  publisher: { "@type": "Organization", name: "GrintByte", url: abs("/") },
  ...(post.data.tags.length && { keywords: post.data.tags.join(", ") }),
};
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article" jsonLd={[postLd]}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:py-16 lg:grid-cols-[14rem_minmax(0,1fr)_14rem] lg:gap-12">
    <aside class="hidden lg:block">
      <BlogSidebar currentId={post.id} />
    </aside>

    <article class="min-w-0">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
        <a href={withBase("/blog")} class="hover:text-brand hover:underline">Blog</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{post.data.title}</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-3 text-sm text-ink-soft">{fmt} · {minutes} min read · GrintByte</p>
      {post.data.cover && (
        <img src={withBase(post.data.cover)} alt="" class="mt-6 w-full rounded-xl border border-brand-wash" />
      )}

      {toc.length > 1 && (
        <details class="mt-6 rounded-xl border border-brand-wash p-4 lg:hidden">
          <summary class="cursor-pointer text-sm font-semibold">On this page</summary>
          <ul class="mt-3 space-y-2">
            {toc.map((h) => (
              <li class={h.depth === 3 ? "pl-4" : ""}>
                <a href={`#${h.slug}`} class="text-sm text-ink-soft hover:text-brand hover:underline">{h.text}</a>
              </li>
            ))}
          </ul>
        </details>
      )}

      <div class="prose-grint mt-8">
        <Content />
      </div>
      {post.data.tags.length > 0 && (
        <p class="mt-8 flex flex-wrap gap-2">
          {post.data.tags.map((t) => (
            <span class="rounded-md bg-brand-wash px-2 py-0.5 text-xs font-semibold text-brand-deep">{t}</span>
          ))}
        </p>
      )}
    </article>

    <aside class="hidden lg:block">
      {toc.length > 1 && (
        <nav aria-label="On this page" id="post-toc" class="sticky top-24">
          <h2 class="font-display text-base font-bold">On this page</h2>
          <ul class="mt-3 space-y-2 border-l border-brand-wash pl-3">
            {toc.map((h) => (
              <li class={h.depth === 3 ? "pl-4" : ""}>
                <a href={`#${h.slug}`} class="block text-sm leading-snug text-ink-soft hover:text-brand hover:underline">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </aside>
  </div>
</BaseLayout>

<script>
  // TOC scrollspy: the heading in view highlights its TOC link, same approach
  // as the product page's section nav.
  const tocNav = document.getElementById("post-toc");
  if (tocNav) {
    const links = Array.from(tocNav.querySelectorAll("a"));
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => {
            const active = a.hash === `#${e.target.id}`;
            a.classList.toggle("text-brand", active);
            a.classList.toggle("font-semibold", active);
            a.classList.toggle("text-ink-soft", !active);
          });
        }
      },
      { rootMargin: "-20% 0px -70% 0px" },
    );
    links.forEach((a) => {
      const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (target) spy.observe(target);
    });
  }
</script>
