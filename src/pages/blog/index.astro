---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/paths";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout
  title="Blog"
  description="Articles from the GrintByte team: product updates, release notes and practical guides for the platforms we build on."
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Blog</h1>
    <p class="mt-3 text-base leading-relaxed text-ink-soft">
      Product updates, release notes and practical guides from the team.
    </p>

    {posts.length === 0 ? (
      <div class="mt-10 rounded-xl border border-dashed border-brand-wash px-6 py-16 text-center">
        <p class="font-display text-lg font-bold">First posts on the way</p>
        <p class="mt-2 text-sm text-ink-soft">
          We are writing the first articles. Meanwhile,
          the <a href={withBase("/products")} class="text-brand hover:underline">product catalog</a> is
          the best place to see what we build.
        </p>
      </div>
    ) : (
      <div class="mt-10 space-y-10">
        {posts.map((post) => (
          <article class="border-b border-brand-wash pb-10 last:border-b-0">
            <h2 class="text-2xl font-extrabold tracking-tight">
              <a href={withBase(`/blog/${post.id}`)} class="hover:text-brand">
                {post.data.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-ink-soft">{fmt(post.data.date)}</p>
            {post.data.cover && (
              <a href={withBase(`/blog/${post.id}`)}>
                <img src={withBase(post.data.cover)} alt="" class="mt-4 w-full rounded-xl border border-brand-wash" loading="lazy" />
              </a>
            )}
            <p class="mt-3 leading-relaxed text-ink-soft">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <p class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((t) => (
                  <span class="rounded-md bg-brand-wash px-2 py-0.5 text-xs font-semibold text-brand-deep">{t}</span>
                ))}
              </p>
            )}
            <a href={withBase(`/blog/${post.id}`)} class="mt-4 inline-block text-sm font-semibold text-brand hover:underline">
              Read more
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
