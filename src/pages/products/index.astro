---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { CATEGORIES } from "../../lib/categories";

const products = (await getCollection("products")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
// Count only platforms that actually have products, so the headline never
// overstates the catalog (6 WordPress plugins is 1 platform, not 7).
const platformCount = new Set(products.map((p) => p.data.category)).size;
---

<BaseLayout
  title="Products"
  description="The full GrintByte catalog: WordPress plugins, Shopify apps, AI tools, Odoo and Dolibarr modules, Chrome extensions and software platforms."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Product catalog</h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">
      {products.length > 0
        ? `${products.length} products across ${platformCount} ${platformCount === 1 ? "platform" : "platforms"}. Filter by platform or search by name.`
        : `The catalog spans ${CATEGORIES.length} platforms. The first product listings are on their way.`}
    </p>

    {products.length === 0 && (
      <div class="mt-10 rounded-xl border border-dashed border-brand-wash px-6 py-16 text-center">
        <p class="font-display text-lg font-bold">Catalog opening soon</p>
        <p class="mt-2 text-sm text-ink-soft">
          We are preparing the first product listings. Need something now? We build to order.
        </p>
      </div>
    )}

    <!-- Filter + search: progressive enhancement. Without JS the full grid and
         the category pages (linked in nav/footer) still work. -->
    <div class={`mt-8 flex-col gap-4 ${products.length > 0 ? "flex" : "hidden"}`}>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="min-h-11 rounded-lg border border-brand bg-brand px-4 py-2 text-sm font-semibold text-white"
        >
          All
        </button>
        {CATEGORIES.map((c) => (
          <button
            type="button"
            data-filter={c.slug}
            aria-pressed="false"
            class="min-h-11 rounded-lg border border-brand-wash px-4 py-2 text-sm font-semibold text-ink-soft hover:border-brand/40 hover:text-brand"
          >
            {c.label}
          </button>
        ))}
      </div>
      <div class="max-w-md">
        <label for="product-search" class="sr-only">Search products</label>
        <input
          type="search"
          id="product-search"
          placeholder="Search by name or description"
          class="min-h-11 w-full rounded-lg border border-brand-wash bg-paper px-4 py-2.5 text-sm placeholder:text-ink-soft/70 focus:border-brand"
        />
      </div>
    </div>

    <div id="product-grid" class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map((p) => (
        <ProductCard product={p} />
      ))}
    </div>

    <!-- Empty state (R-27) -->
    <div id="no-results" class="hidden rounded-xl border border-dashed border-brand-wash px-6 py-16 text-center" role="status">
      <p class="font-display text-lg font-bold">No products match</p>
      <p class="mt-2 text-sm text-ink-soft">Try another search term, or clear the category filter.</p>
      <button
        type="button"
        id="clear-filters"
        class="mt-6 min-h-11 rounded-lg border border-brand/30 px-5 py-2.5 text-sm font-semibold text-brand hover:bg-brand-wash"
      >
        Clear search and filters
      </button>
    </div>
  </section>

</BaseLayout>

<script>
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-product]"));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const search = document.getElementById("product-search") as HTMLInputElement;
  const empty = document.getElementById("no-results")!;
  const grid = document.getElementById("product-grid")!;
  let activeFilter = "all";

  const activeCls = ["border-brand", "bg-brand", "text-white"];
  const idleCls = ["border-brand-wash", "text-ink-soft"];

  function apply() {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matchesCat = activeFilter === "all" || card.dataset.category === activeFilter;
      const matchesText = q === "" || (card.dataset.haystack ?? "").includes(q);
      const show = matchesCat && matchesText;
      card.classList.toggle("hidden", !show);
      if (show) visible++;
    }
    empty.classList.toggle("hidden", visible > 0);
    grid.classList.toggle("hidden", visible === 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeFilter = btn.dataset.filter!;
      buttons.forEach((b) => {
        const on = b === btn;
        b.setAttribute("aria-pressed", String(on));
        b.classList.toggle("hover:border-brand/40", !on);
        b.classList.toggle("hover:text-brand", !on);
        activeCls.forEach((c) => b.classList.toggle(c, on));
        idleCls.forEach((c) => b.classList.toggle(c, !on));
      });
      apply();
    });
  });

  search.addEventListener("input", apply);

  document.getElementById("clear-filters")!.addEventListener("click", () => {
    search.value = "";
    buttons[0].click();
  });
</script>
