---
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import PricingBadge from "../../components/PricingBadge.astro";
import RevealScript from "../../components/RevealScript.astro";
import Icon from "../../components/Icon.astro";
import CircuitMotif from "../../components/CircuitMotif.astro";
import { withBase } from "../../lib/paths";
import { CATEGORIES, categoryByLabel, productPath, type Category } from "../../lib/categories";
import { breadcrumbLd } from "../../lib/seo";

/**
 * One rest-param route serves every /products/* URL shape:
 *   /products/<category-slug>            -> category listing page
 *   /products/<category-slug>/<product>  -> product detail (canonical; matches
 *                                           the breadcrumb, owner-directed SEO)
 *   /products/<product-slug>             -> redirect stub to the canonical URL
 *                                           (the old flat shape stays reachable)
 * Product filenames must still never equal a category slug: the redirect stubs
 * share the single-segment namespace with the category pages.
 */
export async function getStaticPaths() {
  const products = await getCollection("products");
  const categoryPaths = CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { kind: "category" as const, category, product: null },
  }));
  const productPaths = products.map((product) => ({
    params: { slug: productPath(product).replace("/products/", "") },
    props: { kind: "product" as const, category: null, product },
  }));
  const redirectPaths = products.map((product) => ({
    params: { slug: product.id },
    props: { kind: "redirect" as const, category: null, product },
  }));
  return [...categoryPaths, ...productPaths, ...redirectPaths];
}

interface Props {
  kind: "category" | "product" | "redirect";
  category: Category | null;
  product: CollectionEntry<"products"> | null;
}
const { kind, category, product } = Astro.props;

const allProducts = await getCollection("products");
// /contact is hidden for now, so product enquiries fall back to plain email.
const contactData = (await getEntry("contact", "contact"))!.data;
const enquiryMailto = `mailto:${contactData.enquiry_email || contactData.email}`;

// Category page data
const categoryProducts = category
  ? allProducts
      .filter((p) => p.data.category === category.label)
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
  : [];

// Product page data
const data = product?.data;
const productCategory = data ? categoryByLabel(data.category) : undefined;
const related = product
  ? allProducts
      .filter((p) => p.id !== product.id && p.data.category === data!.category)
      .slice(0, 3)
  : [];
const Content = product ? (await render(product)).Content : null;

// CTA labels and glyphs per owner: crown = Pro purchase, download = free version.
const isWpOrg = data?.links.store_url?.includes("wordpress.org") ?? false;
const linkButtons: [string, string, string | undefined][] = data
  ? (
      [
        // Buy first: when a checkout link (e.g. Lemon Squeezy) exists it is
        // the primary action and gets the gradient button styling below.
        ["Buy Now Pro", data.links.buy_url, "crown"],
        // A wordpress.org listing is the free version, not a store page.
        [isWpOrg ? "Download Free" : "Store page", data.links.store_url, isWpOrg ? "download" : undefined],
        ["Live demo", data.links.demo_url, undefined],
        ["Documentation", data.links.docs_url, undefined],
      ] as [string, string | undefined, string | undefined][]
    ).filter((b): b is [string, string, string | undefined] => Boolean(b[1]))
  : [];

// Buy card copy: "$14 one-time" + "Paid" read doubled, so the card shows the
// bare amount with "One-time payment" under it (owner-directed).
const oneTime = data?.price?.toLowerCase().includes("one-time") ?? false;
const cardPrice = oneTime ? data!.price!.replace(/\s*one-time\s*/i, " ").trim() : (data?.price ?? data?.pricing_type);
const cardNote = oneTime ? "One-time payment" : data?.pricing_type;

// License line (owner-directed dual licensing model, see /terms section 3):
// free WordPress versions are GPL, Pro is under the commercial license.
const hasFreeVersion = isWpOrg || (data?.free_vs_pro.length ?? 0) > 0;
const licenseText =
  data?.pricing_type === "Free"
    ? "GPL (open source)"
    : hasFreeVersion
      ? "Free version: GPL. Pro: GrintByte commercial license"
      : "GrintByte commercial license";

// Hero visual: the first REAL screenshot in a browser frame (no fabricated
// mockups); products without screenshots get a brand placeholder instead.
const shot = data?.screenshots[0];
const heroChips = data?.features.slice(0, 3) ?? [];
// Corner anchors only: the frame's center holds the icon when there is no
// screenshot, and a mid-height chip would sit on top of it.
const chipPositions = ["-left-6 top-6", "-right-5 top-[22%]", "-left-3 bottom-8"];

// Section nav (YITH-style): only sections that actually have content.
const sections: [string, string][] = data
  ? [
      ["overview", "Overview"] as [string, string],
      ...(data.features.length ? [["features", "Features"] as [string, string]] : []),
      ...(data.free_vs_pro.length ? [["compare", "Free vs Pro"] as [string, string]] : []),
      ...(data.screenshots.length ? [["screenshots", "Screenshots"] as [string, string]] : []),
      ["tech", "Technical info"] as [string, string],
    ]
  : [];

// Price number for structured data and OG product tags ("$14 one-time" -> "14").
const priceNumber = data?.pricing_type === "Paid"
  ? data.price?.match(/\d+(\.\d+)?/)?.[0]
  : data?.pricing_type === "Free"
    ? "0"
    : undefined;
const productUrl = product ? new URL(withBase(productPath(product)), Astro.site).toString() : "";
const abs = (path: string) => new URL(withBase(path), Astro.site).toString();

const productLd = data
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: data.title,
      description: data.short_description,
      applicationCategory: "BusinessApplication",
      applicationSubCategory: data.category,
      operatingSystem: data.compatibility,
      softwareVersion: data.version,
      url: productUrl,
      ...(data.icon && { image: abs(data.icon) }),
      ...(data.screenshots.length && { screenshot: data.screenshots.map(abs) }),
      ...(data.features.length && { featureList: data.features }),
      ...(data.links.store_url && { installUrl: data.links.store_url }),
      brand: { "@type": "Brand", name: "GrintByte" },
      ...(priceNumber && {
        offers: {
          "@type": "Offer",
          price: priceNumber,
          priceCurrency: "USD",
          availability:
            data.status === "Available" ? "https://schema.org/InStock" : "https://schema.org/PreOrder",
          url: productUrl,
        },
      }),
    }
  : null;

const crumbs = breadcrumbLd(
  Astro.site,
  kind === "category"
    ? [["Products", "/products"], [category!.label, null]]
    : [
        ["Products", "/products"],
        [productCategory!.label, `/products/${productCategory!.slug}`],
        [data!.title, null],
      ],
);
---

{kind === "category" && category && (
  <BaseLayout title={category.label} description={`${category.blurb} The GrintByte ${category.label} catalog.`} jsonLd={[crumbs]}>
    <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
        <a href={withBase("/products")} class="hover:text-brand hover:underline">Products</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{category.label}</span>
      </nav>

      <!-- Category landing hero (owner mockups, filtered: no eyebrow badge,
           specific headline instead of buzzwords, real CTAs) -->
      <div class="mt-8 grid items-center gap-10 lg:grid-cols-[3fr_2fr]">
        <div>
          <p class="reveal revealed font-display text-sm font-bold text-brand">{category.label}</p>
          <h1 class="reveal revealed mt-3 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl" style="--reveal-delay:.1s">
            {category.tagline}
          </h1>
          <p class="reveal revealed mt-5 max-w-xl text-lg leading-relaxed text-ink-soft" style="--reveal-delay:.2s">
            {category.blurb}
          </p>
          <div class="reveal revealed mt-8 flex flex-wrap gap-3" style="--reveal-delay:.3s">
            <a href="#catalog" class="brand-gradient inline-flex min-h-11 items-center rounded-lg px-6 py-3 font-semibold text-white hover:opacity-90">
              Browse {category.label}
            </a>
          </div>
        </div>
        {/* Orbital visual (mirrors the home hero): the category's own
            products float as chips, each a real link to its page. */}
        {categoryProducts.length > 0 ? (
          <div class="relative mx-auto hidden h-[380px] w-full max-w-[440px] lg:block" aria-label={`${category.label} products`}>
            <div class="orbit-ring absolute left-1/2 top-1/2 h-[270px] w-[270px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-brand/15" aria-hidden="true"></div>
            <div class="orbit-ring absolute left-1/2 top-1/2 h-[350px] w-[350px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-brand/10 [animation-direction:reverse]" aria-hidden="true"></div>
            <div class="absolute left-1/2 top-1/2 h-40 w-40 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-light/15 blur-2xl" aria-hidden="true"></div>
            <div class="animate-float absolute left-1/2 top-1/2 flex h-28 w-28 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-brand-wash bg-paper text-brand shadow-lg shadow-brand-deep/10" aria-hidden="true">
              <Icon name={category.icon} class="h-12 w-12" />
            </div>
            {categoryProducts.slice(0, 6).map((p, i) => {
              const pos = [
                "left-0 top-[6%]",
                "right-0 top-[14%]",
                "left-[2%] top-[48%]",
                "right-[2%] top-[52%]",
                "bottom-[4%] left-[10%]",
                "bottom-0 right-[12%]",
              ][i];
              return (
                <a
                  href={withBase(productPath(p))}
                  class={`animate-float absolute ${pos} flex items-center gap-2.5 rounded-xl border border-brand-wash bg-paper/90 px-3 py-2 shadow-md shadow-brand-deep/8 backdrop-blur-sm transition-colors hover:border-brand/40 hover:text-brand`}
                  style={`--float-delay:${(i * 0.7).toFixed(1)}s`}
                >
                  {p.data.icon ? (
                    <img src={withBase(p.data.icon)} alt="" class="h-7 w-7 rounded-md object-contain" loading="lazy" width="28" height="28" />
                  ) : (
                    <span class="flex h-7 w-7 items-center justify-center rounded-md bg-brand-wash text-brand">
                      <Icon name={category.icon} class="h-4 w-4" />
                    </span>
                  )}
                  <span class="text-xs font-semibold">{p.data.title}</span>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="relative mx-auto hidden h-56 w-56 lg:block" aria-hidden="true">
            <div class="orbit-ring absolute inset-0 rounded-full border border-dashed border-brand/15"></div>
            <div class="absolute inset-6 rounded-full bg-brand-light/10 blur-xl"></div>
            <span class="animate-float absolute left-1/2 top-1/2 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-2xl bg-brand-wash text-brand shadow-md shadow-brand-deep/10">
              <Icon name={category.icon} class="h-12 w-12" />
            </span>
          </div>
        )}
      </div>

      <!--
        Empty state (R-27): a category with no products yet
      -->
      {categoryProducts.length > 0 ? (
        <div id="catalog" class="reveal mt-16">
          <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
            All {category.label}
          </h2>
          <p class="mt-2 text-ink-soft">
            {categoryProducts.length} {categoryProducts.length === 1 ? "product" : "products"}, built and maintained by us.
          </p>
          <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {categoryProducts.map((p) => (
              <article class="group relative flex flex-col overflow-hidden rounded-xl border border-brand-wash bg-paper transition-shadow hover:shadow-md hover:shadow-brand-deep/8">
                <!-- Stylized window placeholder, not a fake screenshot: real
                     shots belong in the product's screenshots field. -->
                <div class="border-b border-brand-wash bg-paper-dim" aria-hidden="true">
                  <div class="flex gap-1.5 px-4 pt-3.5">
                    <span class="h-2 w-2 rounded-full bg-brand/20"></span>
                    <span class="h-2 w-2 rounded-full bg-brand/20"></span>
                    <span class="h-2 w-2 rounded-full bg-brand/20"></span>
                  </div>
                  <div class="flex h-28 items-center justify-center text-brand">
                    {p.data.icon ? (
                      <img src={withBase(p.data.icon)} alt="" class="h-14 w-14 object-contain" width="56" height="56" loading="lazy" />
                    ) : (
                      <Icon name={category.icon} class="h-12 w-12" />
                    )}
                  </div>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-base font-bold">
                      <a href={withBase(productPath(p))} class="after:absolute after:inset-0 group-hover:text-brand">
                        {p.data.title}
                      </a>
                    </h3>
                    <PricingBadge pricing_type={p.data.pricing_type} price={p.data.price} />
                  </div>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{p.data.short_description}</p>
                  <p class="mt-4 text-sm font-semibold text-brand">
                    {p.data.status === "Coming Soon" ? "Coming soon" : "View details"}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      ) : (
        <div class="mt-10 rounded-xl border border-dashed border-brand-wash px-6 py-16 text-center">
          <p class="font-display text-lg font-bold">Nothing here yet</p>
          <p class="mt-2 text-sm text-ink-soft">
            No {category.label} are published at the moment.
          </p>
          <a
            href={withBase("/products")}
            class="mt-6 inline-flex min-h-11 items-center rounded-lg border border-brand/30 px-5 py-2.5 text-sm font-semibold text-brand hover:bg-brand-wash"
          >
            Browse all products
          </a>
        </div>
      )}
    </section>
    <RevealScript />
  </BaseLayout>
)}

{/* Old flat URL: an instant client redirect to the canonical nested URL,
    noindexed so search engines follow the canonical instead. */}
{kind === "redirect" && product && data && (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <title>{data.title} | GrintByte</title>
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={productUrl} />
      <meta http-equiv="refresh" content={`0;url=${withBase(productPath(product))}`} />
    </head>
    <body>
      <p>This page has moved to <a href={withBase(productPath(product))}>{productUrl}</a>.</p>
    </body>
  </html>
)}

{kind === "product" && product && data && (
  <BaseLayout title={data.title} description={data.short_description} ogType="product" jsonLd={[productLd!, crumbs]}>
    <Fragment slot="head">
      {data.icon && <meta property="og:image:alt" content={`${data.title} logo`} />}
      {priceNumber && (
        <>
          <meta property="product:price:amount" content={priceNumber} />
          <meta property="product:price:currency" content="USD" />
        </>
      )}
    </Fragment>
    <!-- Hero: same family as the home/solution heroes. The visual is the
         product's first REAL screenshot in a browser frame; never a mockup. -->
    <section class="relative overflow-hidden">
      <CircuitMotif />
      <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 sm:py-16 lg:grid-cols-[3fr_2fr]">
        <div>
          <nav aria-label="Breadcrumb" class="reveal revealed text-sm text-ink-soft">
            <a href={withBase("/products")} class="hover:text-brand hover:underline">Products</a>
            <span aria-hidden="true"> / </span>
            <a href={withBase(`/products/${productCategory?.slug}`)} class="hover:text-brand hover:underline">
              {data.category}
            </a>
            <span aria-hidden="true"> / </span>
            <span aria-current="page">{data.title}</span>
          </nav>
          <div class="reveal revealed mt-5 flex flex-wrap items-center gap-2" style="--reveal-delay:.05s">
            <PricingBadge pricing_type={data.pricing_type} price={data.price} />
            {data.status === "Coming Soon" && (
              <span class="inline-flex items-center rounded-md border border-brand/30 px-2 py-1 text-xs font-semibold text-brand-deep">
                Coming soon
              </span>
            )}
          </div>
          <div class="reveal revealed mt-3 flex items-center gap-4" style="--reveal-delay:.1s">
            {data.icon && (
              <img src={withBase(data.icon)} alt="" class="h-14 w-14 shrink-0 rounded-xl border border-brand-wash object-contain sm:h-16 sm:w-16" width="64" height="64" />
            )}
            <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
              {data.title}
            </h1>
          </div>
          <p class="reveal revealed mt-5 max-w-xl text-lg leading-relaxed text-ink-soft" style="--reveal-delay:.2s">
            {data.short_description}
          </p>
          <div class="reveal revealed mt-8 flex flex-wrap gap-3" style="--reveal-delay:.3s">
            {linkButtons.length > 0 ? (
              <a href={linkButtons[0][1]} rel="noopener" class="brand-gradient inline-flex min-h-11 items-center gap-2 rounded-lg px-6 py-3 font-semibold text-white hover:opacity-90">
                {linkButtons[0][2] && <Icon name={linkButtons[0][2]} class="h-4.5 w-4.5" />}
                {linkButtons[0][0]}
              </a>
            ) : (
              <a href={enquiryMailto} class="brand-gradient inline-flex min-h-11 items-center rounded-lg px-6 py-3 font-semibold text-white hover:opacity-90">
                {data.status === "Coming Soon" ? "Ask for early access" : `Ask about ${data.title}`}
              </a>
            )}
            {linkButtons.length > 1 ? (
              <a href={linkButtons[1][1]} rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-brand/30 px-6 py-3 font-semibold text-brand hover:bg-brand-wash">
                {linkButtons[1][2] && <Icon name={linkButtons[1][2]} class="h-4.5 w-4.5" />}
                {linkButtons[1][0]}
              </a>
            ) : data.features.length > 0 && (
              <a href="#features" class="inline-flex min-h-11 items-center rounded-lg border border-brand/30 px-6 py-3 font-semibold text-brand hover:bg-brand-wash">
                See the features
              </a>
            )}
          </div>
          {(data.version || data.compatibility) && (
            <p class="reveal revealed mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink-soft" style="--reveal-delay:.4s">
              {[data.version && `Version ${data.version}`, data.compatibility].filter(Boolean).map((t) => (
                <span class="inline-flex items-center gap-1.5">
                  <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                  {t}
                </span>
              ))}
            </p>
          )}
        </div>

        <div class="relative mx-auto hidden w-full max-w-[460px] lg:block" aria-hidden="true">
          <div class="absolute left-1/2 top-1/2 h-56 w-80 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-light/15 blur-3xl"></div>
          <div class="animate-float relative overflow-hidden rounded-xl border border-brand-wash bg-paper shadow-xl shadow-brand-deep/15 lg:rotate-1">
            <div class="flex gap-1.5 border-b border-brand-wash bg-paper-dim px-4 py-3">
              <span class="h-2 w-2 rounded-full bg-brand/20"></span>
              <span class="h-2 w-2 rounded-full bg-brand/20"></span>
              <span class="h-2 w-2 rounded-full bg-brand/20"></span>
            </div>
            {shot ? (
              <img src={withBase(shot)} alt="" class="aspect-[16/10] w-full object-cover object-top" fetchpriority="high" />
            ) : (
              <div class="flex aspect-[16/10] w-full items-center justify-center bg-gradient-to-br from-brand-wash to-paper-dim">
                {data.icon ? (
                  <span class="flex h-24 w-24 items-center justify-center rounded-2xl border border-brand-wash bg-paper p-2 shadow-md shadow-brand-deep/10">
                    <img src={withBase(data.icon)} alt="" class="h-full w-full rounded-lg object-contain" />
                  </span>
                ) : (
                  <Icon name={productCategory?.icon ?? "stack"} class="h-16 w-16 text-brand/50" />
                )}
              </div>
            )}
          </div>
          {heroChips.map((f, i) => (
            <span
              class={`animate-float absolute ${chipPositions[i]} flex max-w-[15rem] items-center gap-2 rounded-xl border border-brand-wash bg-paper/95 px-3 py-2 shadow-md shadow-brand-deep/10 backdrop-blur-sm`}
              style={`--float-delay:${(i * 0.7 + 0.4).toFixed(1)}s`}
            >
              <svg class="h-3.5 w-3.5 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
              <span class="truncate text-xs font-semibold">{f}</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Section nav (YITH-style anchors; scrollspy sets the active pill) -->
    <nav id="section-nav" class="sticky top-16 z-30 border-y border-brand-wash bg-paper/95 backdrop-blur-sm" aria-label="On this page">
      <div class="mx-auto flex max-w-6xl gap-2 overflow-x-auto px-4 py-2.5">
        {sections.map(([id, label], i) => (
          <a
            href={`#${id}`}
            class={`filter-btn ${i === 0 ? "is-active" : ""} inline-flex min-h-9 items-center whitespace-nowrap rounded-full border border-brand/30 px-4 py-1 text-sm font-semibold text-brand transition-colors hover:bg-brand-wash`}
          >
            {label}
          </a>
        ))}
      </div>
    </nav>

    <article class="mx-auto max-w-6xl px-4 py-10 sm:py-12">
      <div class="grid gap-10 lg:grid-cols-[2fr_1fr]">
        <div>
          <section id="overview" class="scroll-mt-32" aria-labelledby="overview-title">
            <h2 id="overview-title" class="text-xl font-bold">Overview</h2>
            <div class="prose-grint mt-4 max-w-none">
              {Content && <Content />}
            </div>
          </section>

          {data.features.length > 0 && (
            <section id="features" class="mt-12 scroll-mt-32" aria-labelledby="features-title">
              <h2 id="features-title" class="text-xl font-bold">Features</h2>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {data.features.map((f) => (
                  <li class="flex items-start gap-3 rounded-lg bg-paper-dim p-4 text-sm leading-relaxed">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
            </section>
          )}

          {data.free_vs_pro.length > 0 && (
            <section id="compare" class="mt-12 scroll-mt-32" aria-labelledby="compare-title">
              <h2 id="compare-title" class="text-xl font-bold">Free vs Pro</h2>
              <div class="mt-4 overflow-x-auto rounded-xl border border-brand-wash">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-brand-wash text-left">
                      <th scope="col" class="px-4 py-3 font-semibold">Feature</th>
                      <th scope="col" class="w-32 px-4 py-3 text-center font-semibold">Free</th>
                      <th scope="col" class="w-40 bg-brand-wash px-4 py-3 text-center font-semibold text-brand-deep">Pro</th>
                    </tr>
                  </thead>
                  <tbody>
                    {data.free_vs_pro.map((row) => (
                      <tr class="border-b border-brand-wash last:border-0">
                        <td class="px-4 py-3">{row.feature}</td>
                        {[row.free, row.pro].map((value, i) => (
                          <td class={`px-4 py-3 text-center ${i === 1 ? "bg-brand-wash/60 font-medium text-brand-deep" : "text-ink-soft"}`}>
                            {value === "yes" ? (
                              <>
                                <svg class="mx-auto h-4 w-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                                <span class="sr-only">Included</span>
                              </>
                            ) : value === "no" ? (
                              <>
                                <svg class="mx-auto h-4 w-4 text-ink-soft/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                                <span class="sr-only">Not included</span>
                              </>
                            ) : (
                              value
                            )}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {data.screenshots.length > 0 && (
            <section id="screenshots" class="mt-12 scroll-mt-32" aria-label="Screenshots">
              <h2 class="text-xl font-bold">Screenshots</h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {data.screenshots.map((src, i) => (
                  <>
                    <button type="button" data-shot={`shot-${i}`} class="group overflow-hidden rounded-xl border border-brand-wash transition-shadow hover:shadow-md hover:shadow-brand-deep/10">
                      <img
                        src={withBase(src)}
                        alt={`${data.title} screenshot ${i + 1}`}
                        class="w-full transition-transform group-hover:scale-[1.02]"
                        loading="lazy"
                      />
                    </button>
                    <dialog id={`shot-${i}`} class="shot-dialog m-auto w-[min(94vw,64rem)] rounded-2xl p-0 shadow-xl backdrop:bg-brand-deep/40 backdrop:backdrop-blur-sm">
                      <form method="dialog">
                        <button class="absolute right-3 top-3 flex h-11 w-11 items-center justify-center rounded-full bg-paper/80 text-ink-soft backdrop-blur-sm hover:bg-brand-wash hover:text-brand" aria-label="Close">
                          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                        </button>
                      </form>
                      <img src={withBase(src)} alt={`${data.title} screenshot ${i + 1}`} class="w-full" loading="lazy" />
                    </dialog>
                  </>
                ))}
              </div>
            </section>
          )}

          <section id="tech" class="mt-12 scroll-mt-32" aria-labelledby="tech-title">
            <h2 id="tech-title" class="text-xl font-bold">Technical info</h2>
            <dl class="mt-4 grid gap-x-8 gap-y-4 rounded-xl border border-brand-wash p-6 text-sm sm:grid-cols-2">
              <div>
                <dt class="font-semibold">Category</dt>
                <dd class="mt-0.5 text-ink-soft">
                  <a href={withBase(`/products/${productCategory?.slug}`)} class="text-brand hover:underline">{data.category}</a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold">Status</dt>
                <dd class="mt-0.5 text-ink-soft">{data.status}</dd>
              </div>
              {data.version && (
                <div>
                  <dt class="font-semibold">Version</dt>
                  <dd class="mt-0.5 text-ink-soft">{data.version}</dd>
                </div>
              )}
              {data.compatibility && (
                <div>
                  <dt class="font-semibold">Compatibility</dt>
                  <dd class="mt-0.5 text-ink-soft">{data.compatibility}</dd>
                </div>
              )}
              <div>
                <dt class="font-semibold">License</dt>
                <dd class="mt-0.5 text-ink-soft">
                  {licenseText}.
                  <a href={withBase("/terms")} class="text-brand hover:underline">Licensing terms</a>
                </dd>
              </div>
            </dl>
          </section>
        </div>

        <!-- Buy card (YITH-style): price, the actions, nothing else. -->
        <aside class="h-fit rounded-xl border border-brand-wash bg-paper-dim p-6 lg:sticky lg:top-36">
          <p class="font-display text-3xl font-extrabold tracking-tight text-brand-deep">{cardPrice}</p>
          {data.price && <p class="mt-1 text-sm text-ink-soft">{cardNote}</p>}

          <!--
            No dead buttons (R-26): when no store/demo/docs links exist
            yet, offer the one action that always works.
          -->
          {linkButtons.length > 0 ? (
            <div class="mt-5 flex flex-col gap-2">
              {linkButtons.map(([label, url, iconName], i) => (
                <a
                  href={url}
                  rel="noopener"
                  class={
                    i === 0
                      ? "brand-gradient inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
                      : "inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-brand/30 px-5 py-2.5 text-sm font-semibold text-brand hover:bg-brand-wash"
                  }
                >
                  {iconName && <Icon name={iconName} class="h-4 w-4" />}
                  {label}
                </a>
              ))}
            </div>
          ) : (
            <div class="mt-5">
              <p class="text-sm text-ink-soft">
                {data.status === "Coming Soon"
                  ? "Not released yet. Ask us for early access:"
                  : "Store links are being set up. Reach us directly:"}
              </p>
              <a
                href={enquiryMailto}
                class="brand-gradient mt-3 inline-flex min-h-11 w-full items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
              >
                Ask about {data.title}
              </a>
            </div>
          )}
        </aside>
      </div>

      {related.length > 0 && (
        <section class="mt-16" aria-labelledby="related-title">
          <h2 id="related-title" class="text-xl font-bold">More {data.category}</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )}
    </article>
    <RevealScript />
  </BaseLayout>
)}

<script>
  // Scrollspy for the product section nav: the pill of the section in view
  // gets the same is-active styling as the project filter buttons.
  const secNav = document.getElementById("section-nav");
  if (secNav) {
    const links = Array.from(secNav.querySelectorAll("a"));
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.toggle("is-active", a.hash === `#${e.target.id}`));
        }
      },
      { rootMargin: "-25% 0px -65% 0px" },
    );
    links.forEach((a) => {
      const target = document.getElementById(a.hash.slice(1));
      if (target) spy.observe(target);
    });

    // Screenshot lightbox: native <dialog>, closed by X, Esc, or backdrop.
    document.querySelectorAll<HTMLButtonElement>("[data-shot]").forEach((btn) => {
      btn.addEventListener("click", () => {
        (document.getElementById(btn.dataset.shot!) as HTMLDialogElement).showModal();
      });
    });
    document.querySelectorAll<HTMLDialogElement>(".shot-dialog").forEach((d) => {
      d.addEventListener("click", (e) => {
        if (e.target === d) d.close();
      });
    });
  }
</script>
