---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import PricingBadge from "../../components/PricingBadge.astro";
import CtaBand from "../../components/CtaBand.astro";
import RevealScript from "../../components/RevealScript.astro";
import Icon from "../../components/Icon.astro";
import { withBase } from "../../lib/paths";
import { CATEGORIES, categoryByLabel, type Category } from "../../lib/categories";
import { breadcrumbLd } from "../../lib/seo";

/**
 * One dynamic route serves both URL shapes the site needs:
 *   /products/<category-slug>  -> category listing page
 *   /products/<product-slug>   -> product detail page
 * Astro cannot host two [param] routes in one folder, so getStaticPaths emits
 * both sets. Product filenames must therefore never equal a category slug.
 */
export async function getStaticPaths() {
  const products = await getCollection("products");
  const categoryPaths = CATEGORIES.map((category) => ({
    params: { slug: category.slug },
    props: { kind: "category" as const, category, product: null },
  }));
  const productPaths = products.map((product) => ({
    params: { slug: product.id },
    props: { kind: "product" as const, category: null, product },
  }));
  return [...categoryPaths, ...productPaths];
}

interface Props {
  kind: "category" | "product";
  category: Category | null;
  product: CollectionEntry<"products"> | null;
}
const { kind, category, product } = Astro.props;

const allProducts = await getCollection("products");

// Category page data
const categoryProducts = category
  ? allProducts
      .filter((p) => p.data.category === category.label)
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
  : [];

// Product page data
const data = product?.data;
const productCategory = data ? categoryByLabel(data.category) : undefined;
const related = product
  ? allProducts
      .filter((p) => p.id !== product.id && p.data.category === data!.category)
      .slice(0, 3)
  : [];
const Content = product ? (await render(product)).Content : null;

const linkButtons = data
  ? (
      [
        // Buy first: when a checkout link (e.g. Lemon Squeezy) exists it is
        // the primary action and gets the gradient button styling below.
        ["Buy now", data.links.buy_url],
        ["Store page", data.links.store_url],
        ["Live demo", data.links.demo_url],
        ["Documentation", data.links.docs_url],
      ] as const
    ).filter(([, url]) => url)
  : [];

const productLd = data
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: data.title,
      description: data.short_description,
      applicationCategory: data.category,
      operatingSystem: data.compatibility,
      softwareVersion: data.version,
      url: new URL(withBase(`/products/${product!.id}`), Astro.site).toString(),
    }
  : null;

const crumbs = breadcrumbLd(
  Astro.site,
  kind === "category"
    ? [["Products", "/products"], [category!.label, null]]
    : [
        ["Products", "/products"],
        [productCategory!.label, `/products/${productCategory!.slug}`],
        [data!.title, null],
      ],
);
---

{kind === "category" && category && (
  <BaseLayout title={category.label} description={`${category.blurb} The GrintByte ${category.label} catalog.`} jsonLd={[crumbs]}>
    <section class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
        <a href={withBase("/products")} class="hover:text-brand hover:underline">Products</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{category.label}</span>
      </nav>

      <!-- Category landing hero (owner mockups, filtered: no eyebrow badge,
           specific headline instead of buzzwords, real CTAs) -->
      <div class="mt-8 grid items-center gap-10 lg:grid-cols-[3fr_2fr]">
        <div>
          <p class="reveal revealed font-display text-sm font-bold text-brand">{category.label}</p>
          <h1 class="reveal revealed mt-3 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl" style="--reveal-delay:.1s">
            {category.tagline}
          </h1>
          <p class="reveal revealed mt-5 max-w-xl text-lg leading-relaxed text-ink-soft" style="--reveal-delay:.2s">
            {category.blurb}
          </p>
          <div class="reveal revealed mt-8 flex flex-wrap gap-3" style="--reveal-delay:.3s">
            <a href="#catalog" class="brand-gradient inline-flex min-h-11 items-center rounded-lg px-6 py-3 font-semibold text-white hover:opacity-90">
              Browse {category.label}
            </a>
            <a
              href={withBase("/solutions/custom-development")}
              class="inline-flex min-h-11 items-center rounded-lg border border-brand/30 px-6 py-3 font-semibold text-brand hover:bg-brand-wash"
            >
              Request a custom build
            </a>
          </div>
        </div>
        <div class="relative mx-auto hidden h-56 w-56 lg:block" aria-hidden="true">
          <div class="orbit-ring absolute inset-0 rounded-full border border-dashed border-brand/15"></div>
          <div class="absolute inset-6 rounded-full bg-brand-light/10 blur-xl"></div>
          <span class="animate-float absolute left-1/2 top-1/2 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-2xl bg-brand-wash text-brand shadow-md shadow-brand-deep/10">
            <Icon name={category.icon} class="h-12 w-12" />
          </span>
        </div>
      </div>

      <!--
        Empty state (R-27): a category with no products yet
      -->
      {categoryProducts.length > 0 ? (
        <div id="catalog" class="reveal mt-16">
          <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
            All {category.label}
          </h2>
          <p class="mt-2 text-ink-soft">
            {categoryProducts.length} {categoryProducts.length === 1 ? "product" : "products"}, built and maintained by us.
          </p>
          <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {categoryProducts.map((p) => (
              <article class="group relative flex flex-col overflow-hidden rounded-xl border border-brand-wash bg-paper transition-shadow hover:shadow-md hover:shadow-brand-deep/8">
                <!-- Stylized window placeholder, not a fake screenshot: real
                     shots belong in the product's screenshots field. -->
                <div class="border-b border-brand-wash bg-paper-dim" aria-hidden="true">
                  <div class="flex gap-1.5 px-4 pt-3.5">
                    <span class="h-2 w-2 rounded-full bg-brand/20"></span>
                    <span class="h-2 w-2 rounded-full bg-brand/20"></span>
                    <span class="h-2 w-2 rounded-full bg-brand/20"></span>
                  </div>
                  <div class="flex h-28 items-center justify-center text-brand">
                    {p.data.icon ? (
                      <img src={withBase(p.data.icon)} alt="" class="h-14 w-14 object-contain" width="56" height="56" loading="lazy" />
                    ) : (
                      <Icon name={category.icon} class="h-12 w-12" />
                    )}
                  </div>
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <div class="flex items-start justify-between gap-3">
                    <h3 class="text-base font-bold">
                      <a href={withBase(`/products/${p.id}`)} class="after:absolute after:inset-0 group-hover:text-brand">
                        {p.data.title}
                      </a>
                    </h3>
                    <PricingBadge pricing_type={p.data.pricing_type} price={p.data.price} />
                  </div>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{p.data.short_description}</p>
                  <p class="mt-4 text-sm font-semibold text-brand">
                    {p.data.status === "Coming Soon" ? "Coming soon" : "View details"}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>
      ) : (
        <div class="mt-10 rounded-xl border border-dashed border-brand-wash px-6 py-16 text-center">
          <p class="font-display text-lg font-bold">Nothing here yet</p>
          <p class="mt-2 text-sm text-ink-soft">
            No {category.label} are published at the moment.
          </p>
          <a
            href={withBase("/products")}
            class="mt-6 inline-flex min-h-11 items-center rounded-lg border border-brand/30 px-5 py-2.5 text-sm font-semibold text-brand hover:bg-brand-wash"
          >
            Browse all products
          </a>
        </div>
      )}
    </section>
    <CtaBand
      title={`Need a ${category.label.replace(/s$/, "").toLowerCase()} built for you?`}
      body="If none of these fit, we build to order on every platform we publish for."
      ctaText="Request a custom build"
      ctaHref="/solutions/custom-development"
    />
    <RevealScript />
  </BaseLayout>
)}

{kind === "product" && product && data && (
  <BaseLayout title={data.title} description={data.short_description} jsonLd={[productLd!, crumbs]}>
    <article class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
      <nav aria-label="Breadcrumb" class="text-sm text-ink-soft">
        <a href={withBase("/products")} class="hover:text-brand hover:underline">Products</a>
        <span aria-hidden="true"> / </span>
        <a href={withBase(`/products/${productCategory?.slug}`)} class="hover:text-brand hover:underline">
          {data.category}
        </a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{data.title}</span>
      </nav>

      <div class="mt-6 grid gap-10 lg:grid-cols-[2fr_1fr]">
        <div>
          <div class="flex items-start gap-4">
            {data.icon ? (
              <img src={withBase(data.icon)} alt="" class="h-14 w-14 rounded-xl object-contain" width="56" height="56" />
            ) : (
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-brand-wash text-brand">
                <Icon name={productCategory?.icon ?? "stack"} class="h-7 w-7" />
              </span>
            )}
            <div>
              <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{data.title}</h1>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <PricingBadge pricing_type={data.pricing_type} price={data.price} />
                {data.status === "Coming Soon" && (
                  <span class="inline-flex items-center rounded-md border border-brand/30 px-2 py-1 text-xs font-semibold text-brand-deep">
                    Coming soon
                  </span>
                )}
              </div>
            </div>
          </div>

          <p class="mt-6 text-lg leading-relaxed text-ink-soft">{data.short_description}</p>

          {data.screenshots.length > 0 && (
            <section class="mt-10" aria-label="Screenshots">
              <h2 class="text-xl font-bold">Screenshots</h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {data.screenshots.map((src, i) => (
                  <img
                    src={withBase(src)}
                    alt={`${data.title} screenshot ${i + 1}`}
                    class="w-full rounded-xl border border-brand-wash"
                    loading="lazy"
                  />
                ))}
              </div>
            </section>
          )}

          <section class="prose-grint mt-10 max-w-none">
            {Content && <Content />}
          </section>

          {data.features.length > 0 && (
            <section class="mt-10" aria-labelledby="features-title">
              <h2 id="features-title" class="text-xl font-bold">What it does</h2>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {data.features.map((f) => (
                  <li class="flex items-start gap-3 rounded-lg bg-paper-dim p-4 text-sm leading-relaxed">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <aside class="h-fit rounded-xl border border-brand-wash bg-paper-dim p-6 lg:sticky lg:top-24">
          <h2 class="font-display text-sm font-bold uppercase tracking-wide text-ink-soft">At a glance</h2>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="font-semibold">Pricing</dt>
              <dd class="mt-0.5 text-ink-soft">{data.price ?? data.pricing_type}</dd>
            </div>
            {data.version && (
              <div>
                <dt class="font-semibold">Version</dt>
                <dd class="mt-0.5 text-ink-soft">{data.version}</dd>
              </div>
            )}
            {data.compatibility && (
              <div>
                <dt class="font-semibold">Compatibility</dt>
                <dd class="mt-0.5 text-ink-soft">{data.compatibility}</dd>
              </div>
            )}
            <div>
              <dt class="font-semibold">Status</dt>
              <dd class="mt-0.5 text-ink-soft">{data.status}</dd>
            </div>
          </dl>

          <!--
            No dead buttons (R-26): when no store/demo/docs links exist
            yet, offer the one action that always works.
          -->
          {linkButtons.length > 0 ? (
            <div class="mt-6 flex flex-col gap-2">
              {linkButtons.map(([label, url], i) => (
                <a
                  href={url}
                  rel="noopener"
                  class={
                    i === 0
                      ? "brand-gradient inline-flex min-h-11 items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
                      : "inline-flex min-h-11 items-center justify-center rounded-lg border border-brand/30 px-5 py-2.5 text-sm font-semibold text-brand hover:bg-brand-wash"
                  }
                >
                  {label}
                </a>
              ))}
            </div>
          ) : (
            <div class="mt-6">
              <p class="text-sm text-ink-soft">
                {data.status === "Coming Soon"
                  ? "Not released yet. Ask us for early access:"
                  : "Store links are being set up. Reach us directly:"}
              </p>
              <a
                href={withBase(`/contact`)}
                class="brand-gradient mt-3 inline-flex min-h-11 w-full items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90"
              >
                Ask about {data.title}
              </a>
            </div>
          )}
        </aside>
      </div>

      {related.length > 0 && (
        <section class="mt-16" aria-labelledby="related-title">
          <h2 id="related-title" class="text-xl font-bold">More {data.category}</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )}
    </article>
  </BaseLayout>
)}
