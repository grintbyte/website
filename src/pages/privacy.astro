---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const contact = (await getEntry("contact", "contact"))!.data;
const settings = (await getEntry("settings", "site"))!.data;
const email = contact.enquiry_email || contact.email;
const updated = "15 October 2026";

// The copy below adapts to which integrations are switched on in the CMS,
// so the policy never claims less tracking than the site actually does.
const usesGoogle = Boolean(settings.ga4_id || settings.gtm_id);
const usesPixel = Boolean(settings.meta_pixel_id);
const usesCookies = usesGoogle || usesPixel;
---

<BaseLayout
  title="Privacy Policy"
  description="What GrintByte collects when you use this site, why, and how to reach us about it."
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Privacy policy</h1>
    <p class="mt-3 text-sm text-ink-soft">Last updated: {updated}</p>

    <div class="prose-grint mt-8 space-y-8 text-base leading-relaxed">
      <section>
        <h2 class="text-xl font-bold">The short version</h2>
        <p class="mt-3">
          {usesCookies
            ? "This site collects as little as it can while still measuring whether its marketing works. The analytics tools listed below may set cookies; beyond that, the only personal data we receive is what you type into the enquiry form or send us by email, and we use it solely to reply to you."
            : "This site collects as little as possible. No advertising trackers, no cookies set by us, and nothing is sold or shared for marketing. The only personal data we receive is what you type into the enquiry form or send us by email, and we use it solely to reply to you."}
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">The enquiry form</h2>
        <p class="mt-3">
          When you <a href={withBase("/contact")} class="text-brand underline">get in touch</a>, you
          give us your name, email address, an optional company name and your message. It arrives
          in our mailbox and we keep the correspondence so we can follow up. We do not add you to
          any mailing list.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Purchases</h2>
        <p class="mt-3">
          Product checkout is handled entirely by our payment provider on their own site. Your
          payment details never pass through this website; the provider tells us only what we need
          to deliver the product, such as your email address and what you bought.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Analytics and hosting</h2>
        {settings.cloudflare_analytics_token && (
          <p class="mt-3">
            We measure traffic with Cloudflare Web Analytics, which is cookie-free and does not
            collect personal information or track you across sites.
          </p>
        )}
        {usesGoogle && (
          <p class="mt-3">
            We use Google Analytics{settings.gtm_id ? " (loaded through Google Tag Manager)" : ""} to
            understand how the site is used. It sets cookies and shares usage data with Google as
            described in the
            <a href="https://policies.google.com/privacy" rel="noopener" class="text-brand underline">Google Privacy Policy</a>.
          </p>
        )}
        {usesPixel && (
          <p class="mt-3">
            We use the Meta Pixel to measure the results of our advertising. It sets cookies and
            shares visit data with Meta as described in the
            <a href="https://www.facebook.com/privacy/policy/" rel="noopener" class="text-brand underline">Meta Privacy Policy</a>.
          </p>
        )}
        <p class="mt-3">
          The site is hosted on GitHub Pages, so GitHub may log visits (such as IP addresses) as
          described in the
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener" class="text-brand underline">GitHub Privacy Statement</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold">Your data, your call</h2>
        <p class="mt-3">
          Want to know what we hold about you, or want it deleted? Email
          <a href={`mailto:${email}`} class="text-brand underline">{email}</a> and we will sort it
          out. If this policy changes, the date at the top changes with it.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>
