---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <section class="mx-auto flex max-w-6xl flex-col items-start px-4 py-24 sm:py-32">
    <p class="font-display text-sm font-bold text-brand">404</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">
      That page does not exist
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-ink-soft">
      The link may be outdated, or the product it pointed to may have moved. The catalog and the
      home page are the two best places to start over.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={withBase("/")} class="brand-gradient inline-flex min-h-11 items-center rounded-lg px-6 py-3 font-semibold text-white hover:opacity-90">
        Back to the home page
      </a>
      <a href={withBase("/products")} class="inline-flex min-h-11 items-center rounded-lg border border-brand/30 px-6 py-3 font-semibold text-brand hover:bg-brand-wash">
        Browse the catalog
      </a>
    </div>
  </section>
</BaseLayout>
