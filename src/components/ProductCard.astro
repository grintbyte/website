---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/paths";
import { categoryByLabel } from "../lib/categories";
import Icon from "./Icon.astro";
import PricingBadge from "./PricingBadge.astro";

interface Props {
  product: CollectionEntry<"products">;
}
const { product } = Astro.props;
const { data } = product;
const category = categoryByLabel(data.category);
---

<article
  class="group relative flex flex-col rounded-xl border border-brand-wash bg-paper p-5 transition-shadow hover:shadow-md hover:shadow-brand-deep/8"
  data-product
  data-category={category?.slug}
  data-haystack={`${data.title} ${data.short_description}`.toLowerCase()}
>
  <div class="flex items-start justify-between gap-3">
    <!--
      Honest icon placeholder (R-23): category glyph on a brand wash, no invented logo
    -->
    {data.icon ? (
      <img src={withBase(data.icon)} alt="" class="h-11 w-11 rounded-lg object-contain" width="44" height="44" loading="lazy" />
    ) : (
      <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-wash text-brand">
        <Icon name={category?.icon ?? "stack"} class="h-6 w-6" />
      </span>
    )}
    <PricingBadge pricing_type={data.pricing_type} price={data.price} />
  </div>

  <h3 class="mt-4 text-base font-bold">
    <a href={withBase(`/products/${product.id}`)} class="after:absolute after:inset-0 group-hover:text-brand">
      {data.title}
    </a>
  </h3>
  <p class="mt-0.5 text-xs font-medium text-ink-soft">{data.category}</p>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{data.short_description}</p>

  {data.status === "Coming Soon" && (
    <p class="mt-3 text-xs font-semibold text-brand-deep">Coming soon</p>
  )}
</article>
