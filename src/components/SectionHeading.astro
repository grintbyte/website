---
/**
 * Left-aligned section heading with optional lead paragraph. Left alignment
 * (not the centered-title default) is part of the section rhythm; no eyebrow
 * badge above it (R-09).
 */
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<div class="max-w-2xl">
  <h2 class="text-2xl font-extrabold tracking-tight sm:text-3xl">{title}</h2>
  {lead && <p class="mt-3 text-base leading-relaxed text-ink-soft">{lead}</p>}
</div>
