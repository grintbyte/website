---
/**
 * Circuit-trace motif on a hero's left edge (owner-directed via mockups):
 * echoes the "byte" identity. Decorative only. Parent needs `relative`.
 */
---

<svg
  class="absolute left-0 top-0 hidden h-full w-56 text-brand/10 md:block"
  viewBox="0 0 220 600"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  aria-hidden="true"
  preserveAspectRatio="xMinYMid slice"
>
  <path d="M-20 80h90l40 40v90M-20 190h50l30 30v120l40 40h60M-20 420h110l30-30v-80M-20 520h70l50-50M60 600v-60l30-30" />
  <circle cx="110" cy="210" r="5" /><circle cx="200" cy="280" r="5" />
  <circle cx="120" cy="310" r="5" fill="currentColor" /><circle cx="140" cy="440" r="5" />
  <circle cx="90" cy="600" r="5" /><circle cx="180" cy="470" r="5" fill="currentColor" />
</svg>
